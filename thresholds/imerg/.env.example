# =============================================================================
# IMERG Icechunk pipeline — credentials
# Copy to .env and fill in values. .env is read by python-dotenv at script start.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. NASA Earthdata (GES DISC THREDDS / OPeNDAP)
# -----------------------------------------------------------------------------
# Used by: imerg_hh_gcs_icechunk.py {init, fill, extend}, repair_imerg_tail.py
# Sign up:  https://urs.earthdata.nasa.gov/users/new
# Then "Authorize Application" for "NASA GESDISC DATA ARCHIVE".
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# -----------------------------------------------------------------------------
# 2. Google Cloud Storage service account (GCS-backed Icechunk store)
# -----------------------------------------------------------------------------
# Used by: imerg_hh_gcs_icechunk.py (writes to gs://cpc_awc/ea_imerg_ic_store)
# The script expects a JSON key file at one of:
#   thresholds/imerg/coiled-data-e4drr_202505.json   (current)
#   thresholds/hf-gdo/coiled-data-e4drr_202505.json  (fallback)
# The transfer script (gcs_to_source_coop_transfer.py) uses *_202503.json.
# Roles required on bucket cpc_awc:
#   - Storage Object Admin (read+write+list+delete)
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/coiled-data-e4drr_202505.json

# -----------------------------------------------------------------------------
# 3. Coiled (managed Dask cluster on GCP)
# -----------------------------------------------------------------------------
# Used by: imerg_hh_gcs_icechunk.py fill --n-workers N (omit when --no-cluster)
# Setup:    `coiled login` writes ~/.config/coiled/config.toml; or set token here.
# Workspace: e4drr   Region: us-east1
COILED_TOKEN=
# COILED_WORKSPACE=e4drr     # already hard-coded in script
# COILED_REGION=us-east1     # already hard-coded in script

# -----------------------------------------------------------------------------
# 4. source.coop S3 (target store + write-back for repair)
# -----------------------------------------------------------------------------
# Read access:  anonymous, no creds (already used by check_product_coverage.py
#               --source-coop and compare_imerg_gee_vs_icechunk.py).
# Write access: needed only for repair_imerg_tail.py and gcs_to_source_coop_transfer.py.
# Get keys:     source.coop dashboard → Account → "API Keys" for repository
#               e4drr-project (region us-west-2). They are short-lived
#               session credentials (~12 h), so refresh before each run.
SOURCE_COOP_ACCESS_KEY_ID=
SOURCE_COOP_SECRET_ACCESS_KEY=
SOURCE_COOP_SESSION_TOKEN=

# Either the SOURCE_COOP_* vars above OR the standard AWS_* names will work
# (the script falls back to AWS_* if SOURCE_COOP_* is empty).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# 5. (Optional) Google Earth Engine — only for the validation comparison
# -----------------------------------------------------------------------------
# Used by: compare_imerg_gee_vs_icechunk.py
# The script reads the SA JSON file directly via `--sa ee-service-account.json`,
# so no env var is required. To override location:
# EE_SERVICE_ACCOUNT_FILE=/abs/path/to/ee-service-account.json
